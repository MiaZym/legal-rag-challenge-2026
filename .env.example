# Copy to .env (inside the chosen solution folder) and fill in your own keys
# cp .env.example .env

# === Evaluation API (required for both solutions) ===
EVAL_API_KEY=
EVAL_BASE_URL=https://platform.agentic-challenge.ai/api/v1

# === LLM / Embeddings: pick the set that matches the solution you run ===

# --- v7_warmup (solutions/warmup): Groq (LLM) + Cohere (embeddings + rerank) ---
GROQ_API_KEY=
COHERE_API_KEY=

# --- v2_final (solutions/final): OpenRouter (LLM) + local HuggingFace BGE (embeddings) + Cohere (rerank) ---
OPENROUTER_API_KEY=
# COHERE_API_KEY is also required for the reranker in v2_final

# --- Optional alternatives ---
# OPENAI_API_KEY=

# === Paths (optional, defaults shown) ===
# SUBMISSION_PATH=submission.json
# CODE_ARCHIVE_PATH=code_archive.zip
# QUESTIONS_PATH=questions.json
# DOCS_DIR=docs_corpus
